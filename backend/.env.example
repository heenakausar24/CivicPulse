# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL - Neon)
# Example: postgresql://username:password@hostname:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/civicpulse?schema=public"

# Authentication Secrets
JWT_SECRET="your_jwt_access_secret_key_change_me_in_production"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_change_me_in_production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key"

# Email Configuration (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
EMAIL_FROM="CivicPulse Alerts <no-reply@civicpulse.gov>"
